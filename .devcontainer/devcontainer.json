{
  "name": "Terra Devcontainer",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "USERNAME": "${localEnv:USER}"
    }
  },
  "runArgs": ["--privileged"],
  "customizations": {
    "vscode": {
      "extensions": [
        "rhaiscript.vscode-rhai",
        "1dot75cm.rpmspec",
        "hashicorp.hcl",
        "redhat.vscode-xml",
        "sumneko.lua",
        "nico-castell.linux-desktop-file"
      ]
    },
    "zed": {
      "extensions": ["rhai", "rpmspec", "terraform", "xml", "desktop", "lua"]
    }
  }
}
