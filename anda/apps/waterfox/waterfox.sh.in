#!/usr/bin/bash

export MOZ_APP_LAUNCHER="__PREFIX__/bin/__APP_NAME__"
export MOZ_USE_XINPUT2=${MOZ_USE_XINPUT2-1}
export NSS_SSL_CBC_RANDOM_IV=${NSS_SSL_CBC_RANDOM_IV-1}
export MOZ_APP_REMOTINGNAME=${MOZ_APP_REMOTINGNAME:-__APP_NAME__}
export MOZ_ALLOW_DOWNGRADE=1

exec "__APP_DIR__/__APP_NAME__" "$@"
