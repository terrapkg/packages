# compat links for configs pointing at upstream's /opt/1Password layout
L /opt/1Password/op-ssh-sign     - - - - /usr/libexec/op-ssh-sign
L /opt/1Password/1password       - - - - /usr/bin/1password
L /opt/1Password/1password-mcp   - - - - /usr/bin/1password-mcp
L /opt/1Password/onepassword-mcp - - - - /usr/bin/1password-mcp
