# Generated by go2rpm 1.19.0
%bcond check 1
%undefine _debugsource_packages # fails on f44

# https://github.com/evilmartians/lefthook
%global goipath         github.com/evilmartians/lefthook
Version:                2.2.2

%gometa -f

%global common_description %{expand:
Fast and powerful Git hooks manager for any type of projects.}

Name:           lefthook
Release:        1%{?dist}
Summary:        Fast and powerful Git hooks manager for any type of projects

License:        MIT
URL:            %{gourl}
Source:         %{gosource}
Packager:       Cypress Reed <cypress@fyralabs.com>

BuildRequires:  anda-srpm-macros
BuildRequires:  git-core

Requires:       git-core

%description %{common_description}

%prep
%goprep_online -A

%build
export GO_BUILDTAGS="no_self_update"
export GOTOOLCHAIN=auto
%gobuild -o %{gobuilddir}/bin/%{name} .

%{gobuilddir}/bin/%{name} completion bash > %{name}.bash
%{gobuilddir}/bin/%{name} completion zsh  > _%{name}
%{gobuilddir}/bin/%{name} completion fish > %{name}.fish

%install
install -Dpm0755 %{gobuilddir}/bin/%{name} -t %{buildroot}%{_bindir}
install -Dpm0644 %{name}.bash %{buildroot}%{bash_completions_dir}/%{name}
install -Dpm0644 _%{name}     -t %{buildroot}%{zsh_completions_dir}
install -Dpm0644 %{name}.fish -t %{buildroot}%{fish_completions_dir}

%pkg_completion -Bzf

%if %{with check}
%check
export GO_BUILDTAGS="no_self_update"
export GOTOOLCHAIN=auto
%gotest ./...
%endif

%files
%license LICENSE
%doc README.md CHANGELOG.md docs examples
%{_bindir}/%{name}

%changelog
* Wed Nov 11 2026 Cypress Reed <cypress@fyralabs.com>
- initial package
