+fn is_rpm_managed_exe_path_following_links(path: &Path) -> bool {
+    if is_rpm_managed_exe_path(path) {
+        return true;
+    }
+
+    path.canonicalize()
+        .is_ok_and(|path| is_rpm_managed_exe_path(&path))
+}
+
+fn is_rpm_managed_exe_path(path: &Path) -> bool {
+    let system_bin = path.starts_with("/usr/bin") || path.starts_with("/usr/sbin");
+    system_bin
+        && (Path::new("/usr/lib/sysimage/rpm").exists() || Path::new("/var/lib/rpm").exists())
+}
+
 fn is_mise_managed_exe_path(path: &Path) -> bool {
     mise_install_root(path).is_some()
 }
