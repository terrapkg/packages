+/* Discard all pending events in evdev buffer */
+void drain_devs(struct evdev_context* devs, size_t num_devs) {
+	size_t i;
+	for (i = 0; i < num_devs; ++i) {
+		struct input_event ev;
+		int res;
+		while (libevdev_has_event_pending(devs[i].dev) > 0) {
+			res = libevdev_next_event(devs[i].dev, LIBEVDEV_READ_FLAG_NORMAL, &ev);
+			while (res == LIBEVDEV_READ_STATUS_SYNC) {
+				res = libevdev_next_event(devs[i].dev, LIBEVDEV_READ_FLAG_SYNC, &ev);
+			}
+		}
+	}
+}
