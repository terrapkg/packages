+    assert_eq!(events.len(), 1);
+    assert_eq!(
+        event_value(
+            &events,
+            &Capability::Gamepad(Gamepad::Button(GamepadButton::DPadUp)),
+            0
+        ),
+        Some(InputValue::Float(42.0 / 255.0))
+    );
