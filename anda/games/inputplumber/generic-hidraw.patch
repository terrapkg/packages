+/// A report whose first byte doesn't match the mapping's report_id is skipped
+/// and must not update the per-report-id last state.
+#[test]
+fn test_report_id_mismatch_is_skipped() {
+    let mut map = new_map();
+    let mut config = {
+        let value_type = ValueType::UInt8;
+        HidrawConfig {
+            value_type,
+            byte_start: 1,
+            ..Default::default()
+        }
