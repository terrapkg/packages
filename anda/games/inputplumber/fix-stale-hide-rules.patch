diff --git a/src/input/composite_device/mod.rs b/src/input/composite_device/mod.rs
index f797d5e7f..b7045ba52 100644
--- a/src/input/composite_device/mod.rs
+++ b/src/input/composite_device/mod.rs
@@ -9,6 +9,7 @@ use std::{
         BTreeSet, HashSet,
