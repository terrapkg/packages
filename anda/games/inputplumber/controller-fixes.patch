+        .into_iter()
+        .find_map(|axis| group.get(&axis).map(|c| c.scale))
+        .unwrap_or(1.0);
+    if group.values().any(|c| c.scale != scale) {
+        log::warn!("IIO {group_name} channels report non-uniform scales; using {scale}");
