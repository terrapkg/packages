# Do not modify this file. If you want to add modifications to the repository configurations, add them in /etc/dnf/repos.override.d/

[terra]
name=Terra EL$releasever
#baseurl=https://repos.fyralabs.com/terrael$releasever
metalink=https://tetsudou.fyralabs.com/metalink?repo=terrael$releasever&arch=$basearch
metadata_expire=6h
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terrael$releasever
# Terra currently uses a CDN based on the origin repo, so this is safe
repo_gpgcheck=0
enabled=1
enabled_metadata=1
countme=1
priority=150

[terra-source]
name=Terra EL$releasever - Source
#baseurl=https://repos.fyralabs.com/terrael$releasever-source
metalink=https://tetsudou.fyralabs.com/metalink?repo=terrael$releasever-source&arch=$basearch
metadata_expire=6h
type=rpm
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-terrael$releasever-source
# Terra currently uses a CDN based on the origin repo, so this is safe
repo_gpgcheck=0
enabled=0
enabled_metadata=0
priority=150
