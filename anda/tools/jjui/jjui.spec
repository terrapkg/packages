# Generated by go2rpm 1.19.0
%bcond check 1

# https://github.com/idursun/jjui
%global goipath         github.com/idursun/jjui
Version:                0.10.9

%gometa -f

%global common_description %{expand:
jjui is a terminal user interface for working with the Jujutsu version control
system.}

Name:           jjui
Release:        1%{?dist}
Summary:        Terminal user interface for Jujutsu

License:        MIT AND BSD-3-Clause
URL:            %{gourl}
Source:         %{gosource}
Packager:       ammix <maxim@ammix.dev>

BuildRequires:  anda-srpm-macros

Requires:       jujutsu

%description %{common_description}

%prep
%goprep_online -A

%build
%define currentgoldflags -X main.Version=%{version}
%gobuild -o %{gobuilddir}/bin/%{name} %{goipath}/cmd/%{name}

%install
install -m 0755 -vd                     %{buildroot}%{_bindir}
install -m 0755 -vp %{gobuilddir}/bin/* %{buildroot}%{_bindir}/

%if %{with check}
%check
# SSH askpass test can't authenticate in the build env
%gotest -skip '^TestServerAskpass$' ./...
%endif

%files
%license LICENSE
%doc README.md
%{_bindir}/jjui

%changelog
* Fri Aug 28 2026 ammix <maxim@ammix.dev>
- Initial package
