From a66a96e92638a71f3b054c5988d26b6a4544cd36 Mon Sep 17 00:00:00 2001
From: Carl George <carl@george.computer>
Date: Tue, 25 Aug 2026 16:58:07 +0100
Subject: [PATCH] Remove schema handling from transpile.sh

---
 scripts/transpile.sh | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/scripts/transpile.sh b/scripts/transpile.sh
index b69450f..8630787 100755
--- a/scripts/transpile.sh
+++ b/scripts/transpile.sh
@@ -18,7 +18,6 @@ use_sass() {
 }
 
 echo Compiling into target/...
-glib-compile-schemas schemas &
 for proj in ${PROJECTS}; do
     use_tsc --p src/"${proj}"
 done
@@ -33,7 +32,7 @@ echo
 
 echo Packing into _build/...
 rm -rf _build && mkdir _build
-cp -r metadata.json icons README.md schemas target/* _build/
+cp -r metadata.json icons README.md target/* _build/
 find _build -name "*.tsbuildinfo" -delete
 find _build -name "*.d.ts" -delete
 ls _build
